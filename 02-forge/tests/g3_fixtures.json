{
  "_meta": {
    "purpose": "G3 CARL judge test fixtures — 20 hand-authored synthetic COMPACTED event-stream summaries. Fabricated fixtures only, zero cost, no real Claude API calls made to produce them.",
    "event_types": {
      "system": "session init marker, s='init'",
      "assistant": "one assistant turn; optional 'note' with the assistant's stated intent",
      "tool_use": "a tool call; 'tool' name + 'args'",
      "tool_result": "outcome of the preceding tool_use; 'ok' bool, optional 'err'/'note'/'value'",
      "checkpoint": "compacted periodic telemetry snapshot: cumulative 'num_turns', 'cost_usd', optional 'lines_changed' (marginal progress since prior checkpoint)",
      "watchdog": "compacted stall signal: 'silence_ms' since the last event, 'since_last_event' names that event's type",
      "result": "terminal event — session ended cleanly. carries final 'num_turns' and 'cost_usd'. ABSENCE of this event means the session has no confirmed clean end."
    },
    "expected_verdict_mapping": "expected='continue' for all 10 healthy fixtures (mid-run-with-no-red-flags, or cleanly completed via a 'result' event). expected='stop' for all 10 pathological fixtures (needs supervisor intervention)."
  },
